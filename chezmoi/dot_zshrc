# Make package-manager and user-installed commands available before plugins load.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi
typeset -U path
path=("$HOME/.local/bin" $path)

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
# Chezmoi refreshes these archives; Oh My Zsh should not try to git-update them.
zstyle ':omz:update' mode disabled

# Completion definitions must be present before Oh My Zsh runs compinit.
fpath=("${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src" $fpath)
plugins=(
  git
  fzf-tab
  zsh-autosuggestions
)
source "$ZSH/oh-my-zsh.sh"

# fzf-tab displays the completion menu and groups supplied by Zsh.
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':fzf-tab:*' switch-group '<' '>'

# mise handles runtime versions and project environments when changing directory.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# Copy stdout to the macOS clipboard while still printing it: command | clip
clip() { tee >(pbcopy); }

# Load the single highlighter after all plugins and widget hooks.
source "${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
